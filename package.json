{
  "name": "token-contribution",
  "version": "0.1.1",
  "description": "GitHub-style token usage contribution calendar and analytics for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "heatmap",
    "token-usage",
    "analytics"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.oiupoyt.space/oiupoyt/token-contribution.git"
  },
  "bugs": {
    "url": "https://git.oiupoyt.space/oiupoyt/token-contribution/issues"
  },
  "homepage": "https://git.oiupoyt.space/oiupoyt/token-contribution#readme"
}
